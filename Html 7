<!DOCTYPE html>
<html lang="uz">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="admob-app-id" content="ca-app-pub-1275271216332471~8126283781">
  <title>Match-3 Plant Game</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: linear-gradient(180deg, #1a3a8a 0%, #1e429f 100%);
      color: white;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 15px;
    }

    /* Tepa panel: Bitta tugmada Saqlash + 10 ta til */
    .top-bar {
      width: 100%;
      max-width: 380px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      gap: 10px;
    }

    .btn-save {
      background: #10b981;
      color: white;
      border: none;
      padding: 9px 14px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
      transition: transform 0.1s;
    }

    .btn-save:active {
      transform: scale(0.95);
    }

    #languageSelect {
      background: rgba(255, 255, 255, 0.15);
      color: white;
      border: 1px solid rgba(255, 255, 255, 0.3);
      padding: 8px 12px;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 600;
      outline: none;
      cursor: pointer;
    }

    #languageSelect option {
      background: #1e3a8a;
      color: white;
    }

    /* Statistika paneli: Daraja, Ball, Tanga va 3 ta Spichka */
    .stats-panel {
      width: 100%;
      max-width: 380px;
      background: rgba(255, 255, 255, 0.12);
      border-radius: 18px;
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 18px;
      font-weight: bold;
      margin-bottom: 14px;
    }

    .stat-item {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .status-text {
      font-size: 17px;
      font-weight: 600;
      margin-bottom: 14px;
      min-height: 24px;
      text-align: center;
    }

    /* 5x5 O'yin maydoni */
    .board {
      width: 100%;
      max-width: 380px;
      aspect-ratio: 1 / 1;
      background: rgba(15, 28, 70, 0.65);
      border-radius: 20px;
      padding: 10px;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      grid-template-rows: repeat(5, 1fr);
      gap: 8px;
      margin-bottom: 18px;
    }

    .cell {
      background: rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      cursor: pointer;
      transition: transform 0.15s ease, background 0.15s ease;
    }

    .cell.selected {
      background: rgba(255, 255, 255, 0.28);
      transform: scale(1.08);
      box-shadow: 0 0 12px rgba(255, 255, 255, 0.4);
    }

    /* Pastki boshqaruv tugmalari */
    .controls {
      width: 100%;
      max-width: 380px;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
    }

    .btn {
      border: none;
      border-radius: 16px;
      padding: 14px 8px;
      color: white;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transition: transform 0.1s;
    }

    .btn:active {
      transform: scale(0.95);
    }

    .btn-shuffle { background: #f59e0b; }
    .btn-magic { background: #8b5cf6; }
    .btn-new { background: #ef4444; }

    /* 3 ta spichka tugaganda chiqadigan oyna */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.82);
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 999;
    }

    .modal-box {
      background: #1e3a8a;
      border: 2px solid rgba(255, 255, 255, 0.25);
      border-radius: 22px;
      padding: 24px;
      width: 100%;
      max-width: 320px;
      text-align: center;
    }

    .modal-box h2 {
      margin-bottom: 12px;
      font-size: 22px;
    }

    .modal-box p {
      margin-bottom: 20px;
      font-size: 16px;
      opacity: 0.9;
    }

    .modal-btn {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 14px;
      font-size: 16px;
      font-weight: bold;
      color: white;
      cursor: pointer;
      margin-bottom: 10px;
    }

    .btn-ad { background: #10b981; }
    .btn-restart { background: #ef4444; }
  </style>
</head>
