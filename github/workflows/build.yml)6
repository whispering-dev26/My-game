      display: flex;
      align-items: center;
      gap: 6px;
    }

    .status-text {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 16px;
      min-height: 26px;
      text-align: center;
    }

    .board {
      width: 100%;
      max-width: 380px;
      aspect-ratio: 1 / 1;
      background: rgba(15, 28, 70, 0.65);
      border-radius: 20px;
      padding: 10px;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      grid-template-rows: repeat(5, 1fr);
      gap: 8px;
      margin-bottom: 20px;
    }

    .cell {
      background: rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 36px;
      cursor: pointer;
      transition: transform 0.15s ease, background 0.15s ease;
    }

    .cell.selected {
      background: rgba(255, 255, 255, 0.28);
      transform: scale(1.08);
      box-shadow: 0 0 12px rgba(255, 255, 255, 0.4);
    }

    .controls {
      width: 100%;
      max-width: 380px;
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
    }

    .btn {
      border: none;
      border-radius: 16px;
      padding: 14px 8px;
      color: white;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      transition: transform 0.1s;
    }

    .btn:active {
      transform: scale(0.95);
    }

    .btn-shuffle { background: #f59e0b; }
    .btn-magic { background: #8b5cf6; }
    .btn-new { background: #ef4444; }
